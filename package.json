{
  "name": "xiangqi",
  "version": "1.0.0",
  "description": "Chinese Chess with Pikafish AI Engine",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --mac",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": ["xiangqi", "chinese-chess", "pikafish"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xiangqi.app",
    "productName": "象棋 Xiangqi",
    "mac": {
      "category": "public.app-category.board-games",
      "target": "dir",
      "identity": null
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "pikafish",
        "to": "pikafish"
      },
      {
        "from": "pikafish.nnue",
        "to": "pikafish.nnue"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "asar": true
  }
}
